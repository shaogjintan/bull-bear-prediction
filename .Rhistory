X <- as.matrix(iris[,1:4])
for (i in 1:ncol(X)){
X[,i] <- X[,i] - mean(X[,i])
}
X
# 3(a)(i) Covariance matrix, its eigenvalues and eigenvectors
C <- (t(X) %*% X) / (nrow(X) - 1)
C
eigen(C)
# 3(a)(ii)
Y <- svd(X)
plot(Y$d, pch = 19)
# 3(a)(ii)
Y <- svd(X)
plot(Y$d, pch = 19)
totalvar <- sum(Y$d^2)
cat("Variance explained by PC1:", Y$d[1]^2 / total_var*100)
cat("Variance explained by PC2:", Y$d[2]^2 / total_var*100)
# 3(a)(ii)
Y <- svd(X)
plot(Y$d, pch = 19)
totalvar <- sum(Y$d^2)
cat("Variance explained by PC1:", Y$d[1]^2 / totalvar*100)
cat("Variance explained by PC2:", Y$d[2]^2 / totalvar*100)
# 3(a)(iii) Sign structure of first 2 PCs
r <- 2
U <- Y$u
S <- diag(Y$d)
V <- Y$v
V
Z <- X%*%V
plot(Z[,1:r],col=iris$Species)
