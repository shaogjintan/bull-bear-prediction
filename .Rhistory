## 2(a) function mylu that computes LU factorization of a square, non-singular matrix
mylu <- function(A){
n <- row(A)
for (i in 2:(n-1)) {
A[i,] = A[i-1,i-1] * A[i,]
}
}
## 2(a) function mylu that computes LU factorization of a square, non-singular matrix
mylu <- function(A){
n <- nrow(A)
for (c in 1:(n-1)) { # looping through the columns. last col no need elimination.
for (r in (c+1):n) { # looping through rows below the pivot row
A[r,c] <- A[r,c] / A[c,c] # compute multiplier
A[r, (c+1):n] <- A[r, (c+1):n] - A[r,c] * A[c, (c+1):n]
}
}
A
}
