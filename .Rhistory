## 3(b) Using method from Week 4, using Cholesky factorization
set.seed(123)
n <- 1000
corr <- 0.7 # pairwise correlation
# make independent standard normals
x1 <- rnorm(1000)
x2 <- rnorm(1000)
x3 <- rnorm(1000)
df <- rbind(x1,x2,x3)
# correlation matrix
s <- matrix(corr, nrow = 3, ncol = 3) # diagonal, corr(xi,xi) = 1
diag(s) <- 1 # off diagonal, corr(xi,xj) = corr
SC <- chol(s)
# impose correlation using Cholesky
df <- t(SC) %*% df
# convert normal to uniform
u1 <- pnorm(df[1,])
u2 <- pnorm(df[2,])
u3 <- pnorm(df[3,])
# transform to required distribution
X1 <- qnorm(u1, mean = 10, sd = 2)
X2 <- qexp(u2, rate = 1)
X3 <- qgamma(u3, shape = 2, rate = 2)
x <- cbind(X1, X2, X3)
colMeans(X)
X <- cbind(X1, X2, X3)
colMeans(X)
apply(X,2,var)
cor(X)
## 3(c) Repeat 3(b) 500 times
set.seed(123)
n <- 1000
corr <- 0.7
# matrix to store results
means <- matrix(0, nrow = 500, ncol = 3)
vars <- matrix(0, nrow = 500, ncol = 3)
cors <- matrix(0, nrow = 500, ncol = 3)
# loop (b) 500 times
for (i in 1:500) {
# make independent standard normals
x1 <- rnorm(n)
x2 <- rnorm(n)
x3 <- rnorm(n)
df <- rbind(x1,x2,x3)
# correlation matrix
s <- matrix(corr, nrow = 3, ncol = 3) # diagonal, corr(xi,xi) = 1
diag(s) <- 1 # off diagonal, corr(xi,xj) = corr
SC <- chol(s)
# impose correlation using Cholesky
df <- t(SC) %*% df
# convert normal to uniform
u1 <- pnorm(df[1,])
u2 <- pnorm(df[2,])
u3 <- pnorm(df[3,])
# transform to required distribution
X1 <- qnorm(u1, mean = 10, sd = 2)
X2 <- qexp(u2, rate = 1)
X3 <- qgamma(u3, shape = 2, rate = 2)
X <- cbind(X1, X2, X3)
# record values
means[i,] <- colMeans(X) #[mean(X1),mean(X2),mean(X3)]
vars[i,]  <- apply(X,2,var) #[var(X1),var(X2),var(X3)]
C <- cor(X) # this is a 3x3 matrix
cors[i,] <- c(C[1,2], C[1,3], C[2,3]) #[cor(X1,X2),cor(X1,X3),cor(X2,X3)]
}
colMeans(means)
colMeans(vars)
colMeans(cors)
