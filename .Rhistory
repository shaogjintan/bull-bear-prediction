## FRED MD ##
fred_raw <- read.csv("data/fred_md_2026-09.csv")
dim(fred_raw)
fred_raw[1:3, 1:6]
tail(fred_raw[, 1:4])
fred <- fred_raw |>
slice(-1) |>
mutate(date = as.Date(sasdate, format = "%m/%d/%Y")) |>
select(-sasdate) |>
relocate(date)
# need to transform variables
tcode <- fred_raw |> slice(1) |> select(-sasdate) |> unlist() # transformation codes
fred <- fred_raw |>
slice(-1) |>
mutate(date = as.Date(sasdate, format = "%m/%d/%Y")) |>
select(-sasdate) |>
relocate(date)
View(fred_raw)
switch(as.character(code),
"1" = x, # if code is 1, return x unchanged
"2" = d(x), # if code is 2, return first diff
"3" = d(d(x)), # return 2nd diff
"4" = log(x), # etc
"5" = d(log(x)),
"6" = d(d(log(x))),
"7" = d(x / lag(x) - 1))
fred <- fred_raw |>
slice(-1) |> # remove code row
mutate(date = as.Date(sasdate, format = "%m/%d/%Y")) |> # convert to date format
select(-sasdate) |>
relocate(date) # move date to first col
# define transformation function (standard according to fred appendix)
tf <- function(x, code) { # function takes in variable, transformation code
d <- function(v) v - lag(v) # helper function that gives 1st difference
switch(as.character(code),
"1" = x, # if code is 1, return x unchanged
"2" = d(x), # if code is 2, return first diff
"3" = d(d(x)), # return 2nd diff
"4" = log(x), # etc
"5" = d(log(x)),
"6" = d(d(log(x))),
"7" = d(x / lag(x) - 1))
}
# apply to all cols
fred_t <- fred |> mutate(across(-date, ~ tf(.x, tcode[[cur_column()]])))
dim(fred_t)                                   # expect 812 127
table(tcode)                                  # only codes 1 to 7
all(sapply(fred, is.numeric))                 # expect TRUE
fred_t$RPI[2:3]                               # vs the line below
log(fred$RPI[2:3]) - log(fred$RPI[1:2])
sapply(fred[-1], is.numeric) |> all()          # expect TRUE
names(fred)[!sapply(fred, is.numeric)]         # lists any non-numeric columns
glimpse(fred_t)
fred_t |> summarise(across(everything(), ~ sum(is.na(.x)))) |>
pivot_longer(everything(), names_to = "var", values_to = "n_na") |>
arrange(desc(n_na)) |> head(15)
sort(colSums(is.na(fred_t)), decreasing = TRUE) |> head(15)
