trilu <- function(B) {
n <- nrow(B)
for (c in 1:(n-1)) { # loop through each column
r <- c + 1 # only 1 row below the pivot
B[r,c] <- B[r,c] / B[c,c] # compute multiplier
B[r, c+1] <- B[r, c+1] - B[r,c] * B[c, c+1]
}
B
}
B <- matrix(0, 6, 6)
diag(B) <- rnorm(6)
diag(B[-1,]) <- rnorm(5)
diag(B[,-1]) <- rnorm(5)
test_lu_B <- trilu(B)
B
# generate L and U
U_B <- test_lu_B
U_B[lower.tri(U_B)] <- 0
L_B <- test_lu_B
L_B[upper.tri(L_B)] <- 0
diag(L_B) <- 1
# multiply L and U together and compare
B_test <- L_B %*% U_B
B_test
B
B_test - B
wtm.cholesky <- function(A){
n <- nrow(A)
for (i in 1:(n-1)){
A[i,i] <- sqrt(A[i,i])
for (j in (i+1):n){
A[j,i] <- A[j,i]/A[i,i]
}
for (j in (i+1):n){
for (k in j:n){
A[k,j] <- A[k,j] - (A[k,i]*A[j,i])
}
}
}
A[n,n] <- sqrt(A[n,n])
return(A)
}
