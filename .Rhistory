# Taking ref from week 9 student population problem
# Create Transition matrix
A <- matrix(c(
0,0,0,0,0, # no one transitions into first week
0,0.5,0,0,0, # 50% retention for 2nd week
0,0,0.6,0,0, # 60% into 3rd week
0,0,0,0.75,0, # 75% into 4th week
0,0,0,0.5,1 # 50% become regular active user)
), nrow = 5, byrow = FALSE)
A
# Taking ref from week 9 student population problem
# Create Transition matrix
A <- matrix(0, nrow = 5, ncol = 5)
A[2,1] <- 0.50  # 50% week1 -> week2
A[3,2] <- 0.60  # 60% week2 -> week3
A[4,3] <- 0.75  # 75% week3 -> week4
A[5,4] <- 0.50  # 50% week4 -> regular
A[5,5] <- 1     # regular stay regular
b <- c(1000,0,0,0,0)
A
# Baseline no campaign
x <- b
for (i in 1:20){
x <- A%*%x+b
}
x
# Baseline no campaign
x <- b
for (i in 1:50){
x <- A%*%x+b
}
x
# Baseline no campaign
x <- b
for (i in 1:200){
x <- A%*%x+b
}
x
# Baseline no campaign
x <- b
for (i in 1:500){
x <- A%*%x+b
}
x
# Baseline no campaign
x <- b
for (i in 1:100){
x <- A%*%x+b
}
x
# Baseline no campaign
x <- b
for (i in 1:100){
x <- A%*%x+b
}
x
# Campaign 1: cost $5 million. generates additional 4000 new players next week (only once off)
x1 <- b + c(4000,0,0,0) # this is already week 1 before the loop
for (i in 2:100){
x1 <- A %*% x1 + b     # back to normal b after
}
x1
# Campaign 1: cost $5 million. generates additional 4000 new players next week (only once off)
x1 <- b + c(4000,0,0,0,0) # this is already week 1 before the loop
for (i in 2:100){
x1 <- A %*% x1 + b     # back to normal b after
}
x1
# Campaign 2: cost $2 million. improve retention from wk1 to wk2 to 75%
A2 <- A
A2[2,1] <- 0.75
x2 <- A2%*%b + b # week 1
for (i in 2:100){
x2 <- A2 %*% x2 + b     # back to normal b after
}
x2
# Campaign 3: cost $3 million. improve conversion of 4 week players to regular active users to 75% for the next 3 weeks
A3 <- A
A3 [5,4] <- 0.75
x3 <- b
for (i in 1:100){
if  (i<=3) x3 <- A3 %*% x3 + b
else x3 <- A %*% x3 + b
}
x3
