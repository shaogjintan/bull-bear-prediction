# Taking ref from week 7 lecture
# Givens rotations
wtm.Givens <- function(x,j){
n <- length(x)
xn <- sqrt(x[1]^2 + x[j]^2)
cs <- x[1]/xn
sn <- x[j]/xn
G <- diag(1,n)
G[1,1] <- cs
G[1,j] <- sn
G[j,1] <- -sn
G[j,j] <- cs
return(G)
}
# QR factorization adapted for Hessenberg
hessen.GivensQR <- function(A){
n <- nrow(A) # n x n matrix
Q <- diag(1,n)
for (i in 1:(n-1)){
# only 1 rotation needed per column
# only A[i+1,i] is non zero below diagonal (dont need the j loop as j only takes value i+1)
G <- diag(1,n)
G[i:n,i:n] <- wtm.Givens((A[i:n,i]),2) # j=2 since we only target the entry below diagonal
A <- G%*%A # apply rotation to A to zero out A[i+1,i]
Q <- Q%*%t(G)
}
return(list(Q,A))
}
